# ----------------------------------------------------------------------
# Dharani Herbals - Production .htaccess for Apache / LiteSpeed (Hostinger)
# Ensures WhatsApp, Facebook, and search crawlers receive pre-rendered HTML
# with dynamic Open Graph tags, images, and prices.
# ----------------------------------------------------------------------

Options -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --------------------------------------------------------------------
  # 0. API Reverse Proxy Routing (HTTPS same-origin to Django Backend)
  # --------------------------------------------------------------------
  # Route /api/* and /media/* directly to secure PHP reverse proxy, preventing Mixed Content blocks
  RewriteRule ^api/(.*)$ api_proxy.php?__route=$1 [QSA,L]
  RewriteRule ^api/?$ api_proxy.php?__route= [QSA,L]
  RewriteRule ^media/(.*)$ api_proxy.php?__route=media/$1 [QSA,L]

  # --------------------------------------------------------------------
  # 1. Social Crawler Explicit Routing (WhatsApp, Facebook, Twitter, Telegram, etc.)
  # --------------------------------------------------------------------
  # When WhatsApp or Facebook crawler requests /product/:id:
  # Route directly to the pre-rendered HTML file containing Open Graph metadata.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot) [NC]
  RewriteCond %{REQUEST_URI} ^/product/([0-9]+)/?$
  RewriteRule ^product/([0-9]+)/?$ product/$1/index.html [L]

  # --------------------------------------------------------------------
  # 2. Pre-rendered Static Directory & File Matching
  # --------------------------------------------------------------------
  # If /product/1255 is requested and product/1255/index.html exists on disk:
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # If /product/1255 is requested and product/1255.html exists on disk:
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # --------------------------------------------------------------------
  # 3. Existing static files (images, JS, CSS, fonts, audio, video)
  # --------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --------------------------------------------------------------------
  # 4. Dynamic Server-Side Fallback for newly created products (PHP)
  # --------------------------------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot) [NC]
  RewriteCond %{REQUEST_URI} ^/product/([0-9]+)/?$
  RewriteRule ^product/([0-9]+)/?$ product.php?id=$1 [L,QSA]

  # --------------------------------------------------------------------
  # 5. Standard SPA Fallback
  # --------------------------------------------------------------------
  # All other client-side routes fallback to index.html for React Router.
  RewriteRule ^ index.html [L]
</IfModule>

# Ensure correct MIME types for modern web assets
<IfModule mod_mime.c>
  AddType text/html .html
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
</IfModule>

# ----------------------------------------------------------------------
# Browser Caching Headers
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - Never cache so new builds and deployments show up immediately
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript - 1 year (cache busted by Vite hash)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Images and Media
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Always permit unload Permissions-Policy across all document routes for third-party SDK compatibility
  Header always set Permissions-Policy "unload=*"

  # HTML - Always revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Vite hashed assets in /assets/ folder
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
